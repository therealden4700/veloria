# Комната Veloria.
#
# Ставить нечего: у игры нет зависимостей вовсе, а база — `node:sqlite`,
# встроенный модуль. Поэтому здесь нет ни `npm install`, ни этапа сборки, ни
# слоя с чужими пакетами — только Node и исходники.
#
# Node 22.5 и новее обязателен: раньше `node:sqlite` не было.
FROM node:22-alpine

# Базу держим на отдельном томе, а не в образе: образ заменяется при каждом
# обновлении, а персонажи должны это пережить.
ENV VELORIA_DB=/data/veloria.db
ENV PORT=8080
ENV NODE_ENV=production

WORKDIR /app
COPY . .
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8080

# Проба готовности. `/health` отвечает состоянием комнат — по нему хостер и
# поймёт, что образ поднялся, а не молча упал на старте.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/health" > /dev/null || exit 1

# Прямой запуск, без оболочки: иначе `SIGTERM` от хостера уйдёт в `sh`, а не в
# сервер, — и остановка перестанет быть мягкой. А мягкая она затем, что комната
# пишет персонажей раз в восемь секунд, и при обновлении эти восемь секунд
# чужой игры иначе пропадают.
CMD ["node", "server/server.js"]
