# Настоящие учётные записи и персонажи игроков.
#
# В `data/veloria.db` лежат адреса кошельков Solana тех, кто заходил, и их
# персонажи. Это чужие данные, и в публичном репозитории им не место — сервер
# создаёт базу заново при первом запуске, ничего восстанавливать не нужно.
data/
*.db
*.db-shm
*.db-wal

# Мусор macOS и редакторов
.DS_Store
*.swp
*~

# Локальные настройки, которые не про проект
.claude/settings.local.json

# Зависимостей у игры нет, но если кто-то поставит инструменты рядом
node_modules/
